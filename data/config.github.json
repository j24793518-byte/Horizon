{
  "version": "1.0",
  "ai": {
    "provider": "anthropic",
    "model": "claude-haiku-4-5-20251001",
    "api_key_env": "ANTHROPIC_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "xxx@qq.com",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [{"type": "repo_releases","owner": "astral-sh","repo": "uv","enabled": true}],
    "hackernews": {"enabled": true,"fetch_top_stories": 20,"min_score": 100},
    "rss": [{"name": "Simon Willison","url": "https://simonwillison.net/atom/everything/","enabled": true,"category": "ai-tools"}],
    "reddit": {"enabled": true,"subreddits": [{"subreddit": "MachineLearning","enabled": true,"sort": "hot","time_filter": "day","fetch_limit": 15,"min_score": 50},{"subreddit": "artificial","enabled": true,"sort": "hot","time_filter": "day","fetch_limit": 10,"min_score": 30}],"users": [],"fetch_comments": 5},
    "twitter": {"enabled": false,"users": ["karpathy","ylecun"],"fetch_limit": 10,"fetch_reply_text": false,"max_replies_per_tweet": 3,"max_tweets_to_expand": 10,"reply_min_likes": 5},
    "openbb": {"enabled": false},
    "ossinsight": {"enabled": false}
  },
  "filtering": {"ai_score_threshold": 6.0,"time_window_hours": 24},
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "telegram",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": ["zh"],
    "request_body": {"chat_id": "6282740301","text": "#{summary}","parse_mode": "Markdown"},
    "headers": ""
  }
}
